[Unit]
Description=Vvuzz Online local admissions analyzer
After=network.target

[Service]
Type=simple
User=dev
Group=intdata
WorkingDirectory=/int/vvuzz
Environment=PYTHONUNBUFFERED=1
Environment=VVUZZ_DB_PATH=/int/.runtime/vvuzz-public/data/vuzonline.vds.sqlite
EnvironmentFile=-/int/vvuzz/.env
ExecStart=/usr/bin/python3 /int/vvuzz/app.py --host 127.0.0.1 --port 9176
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/int/.runtime/vvuzz-public/data
InaccessiblePaths=/int/vvuzz/.git

[Install]
WantedBy=multi-user.target

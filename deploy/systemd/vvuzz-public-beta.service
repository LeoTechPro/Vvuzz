[Unit]
Description=Vvuzz Public beta admissions navigator
After=network.target

[Service]
Type=simple
User=agents
Group=intdata
WorkingDirectory=/int/vvuzz
Environment=PYTHONUNBUFFERED=1
Environment=VVUZZ_ENV=production
Environment=VVUZZ_BASE_PATH=/beta
Environment=VVUZZ_DB_PATH=/int/vvuzz/vuzonline_2025_norm.vds.sqlite
EnvironmentFile=/int/vvuzz/.env.public
ExecStart=/usr/bin/python3 -m uvicorn vvuzz_public.main:app --host 127.0.0.1 --port 9186 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/int/vvuzz

[Install]
WantedBy=multi-user.target

# Proposed beta additions. This file is source-only and is not installed by the
# implementation commit. `limit_req_zone` and `log_format` belong to http{}.
log_format vvuzz_public '$remote_addr - $host [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
limit_req_zone $binary_remote_addr zone=vvuzz_public_lookup:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=vvuzz_manage_login:10m rate=5r/m;

# Add these locations to the existing TLS server{}.
location = /beta {
    return 308 /beta/;
}

location = /beta/api/public/lookup {
    limit_req zone=vvuzz_public_lookup burst=5 nodelay;
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:9186/api/public/lookup;
}

location = /beta/api/public/competition {
    limit_req zone=vvuzz_public_lookup burst=5 nodelay;
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:9186/api/public/competition;
}

location = /beta/manage/login {
    limit_req zone=vvuzz_manage_login burst=3 nodelay;
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:9186/manage/login;
}

location /beta/ {
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering on;
    proxy_read_timeout 30s;
    proxy_connect_timeout 5s;
    proxy_pass http://127.0.0.1:9186/;
}

# The existing location for /api/ingest/batch continues to use port 9176.
# Route /beta/api/ingest/v2/batch to port 9186 only after parser coordination.

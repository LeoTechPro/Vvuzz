# Proposed beta locations for the existing TLS server{}.
# Install vvuzz-public-http.conf.example in http{} first.
location = /beta {
    return 308 /beta/;
}

location = /beta/api/public/lookup {
    limit_req zone=vvuzz_public_lookup burst=5 nodelay;
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:9186/api/public/lookup;
}

location = /beta/lookup {
    limit_req zone=vvuzz_public_lookup burst=5 nodelay;
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:9186/lookup;
}

location = /beta/api/public/competition {
    limit_req zone=vvuzz_public_lookup burst=5 nodelay;
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:9186/api/public/competition;
}

location = /beta/manage/login {
    limit_req zone=vvuzz_manage_login burst=3 nodelay;
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:9186/manage/login;
}

location = /api/ingest/v2/batch {
    client_max_body_size 25m;
    access_log /var/log/nginx/vvuzz-ingest-v2.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_read_timeout 120s;
    proxy_pass http://127.0.0.1:9186/api/ingest/v2/batch;
}

location /beta/ {
    access_log /var/log/nginx/vvuzz-public.access.log vvuzz_public;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering on;
    proxy_read_timeout 30s;
    proxy_connect_timeout 5s;
    proxy_pass http://127.0.0.1:9186/;
}

# The existing location for /api/ingest/batch continues to use port 9176.
# Enable /api/ingest/v2/batch only after parser coordination.
